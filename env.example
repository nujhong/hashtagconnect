# Copy to .env. Void reads only .env, not .env.local or .dev.vars.
# Credentials belong only on the server. Do not use VITE_ prefixes.
X_CLIENT_ID=
X_CLIENT_SECRET=
# One Cloudflare API token with Workers AI Read and AI Gateway Run permissions.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_AI_GATEWAY_TOKEN=
