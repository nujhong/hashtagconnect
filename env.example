# Copy to .env. Void reads only .env, not .env.local or .dev.vars.
# Credentials belong only on the server. Do not use VITE_ prefixes.
AUTH_TWITTER_CLIENT_ID=
AUTH_TWITTER_CLIENT_SECRET=
# Stable numeric X account ID allowed to curate the shared pool.
# Leave blank to disable shared publishing. Private URL saves still work.
CURATOR_X_ID=

# Cloudflare's native Jev endpoint requires Workers AI Read in addition to gateway access.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_GATEWAY_ID=
CF_AIG_TOKEN=
CF_WORKERS_AI_TOKEN=
# Local development: omit SCAN_DAILY_LIMIT for unlimited attempts (provider limits apply).
# A value of 0 pauses scans. Production builds require a positive daily cap AND a
# positive cache lifetime in seconds. Choose both deliberately before launch; no defaults.
# The daily cap is global, per UTC day, and counts inference attempts including failures.
# Cache reuse is production-only and avoids inference when the complete input is unchanged.
# SCAN_DAILY_LIMIT=
# SCAN_CACHE_TTL_SECONDS=
